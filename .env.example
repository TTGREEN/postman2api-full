# ── Service ──────────────────────────────────────────
HOST=127.0.0.1
PORT=1930
DASHBOARD_PORT=1931

# ── Authentication ───────────────────────────────────
API_KEY=postman2api-secret-key
ENCRYPTION_KEY=change-this-to-a-random-32-char-hex-string

# ── Database ─────────────────────────────────────────
DATABASE_PATH=./data/postman2api.db

# ── Upstream networking ──────────────────────────────
# Time to wait for upstream response headers.
TTFB_TIMEOUT_MS=45000
# Maximum idle time between streamed response chunks.
STREAM_READ_TIMEOUT_MS=300000
# Fallback connect timeout for provider calls that do not set TTFB_TIMEOUT_MS.
PROVIDER_REQUEST_TIMEOUT_MS=120000
# Maximum bytes buffered per streamed response before it is exposed to the client.
# Buffering lets the proxy discard partial output and replay on another account
# when quota exhaustion arrives after the upstream already generated content.
QUOTA_SAFE_STREAM_BUFFER_BYTES=16777216
# SSE comment heartbeat while a quota-safe response is being buffered or replayed.
STREAM_KEEPALIVE_INTERVAL_MS=10000
# Safe Postman fetch lifecycle diagnostics (URL path/status/timing/byte counts only).
# Authentication headers and request/response bodies are never logged.
POSTMAN_FETCH_VERBOSE=false
# On a cold start, prime the upstream conversation with the history split across
# several requests instead of clamping it to the 10000-char single-request limit.
# Each segment is a real upstream generation and consumes quota. Set to 0 to disable.
POSTMAN_CONTEXT_PRIMING=true
# Maximum priming segments per request; beyond this the proxy skips priming and
# falls back to budgeted clamping with a truncation warning.
POSTMAN_CONTEXT_PRIMING_MAX_SEGMENTS=40

# ── Browser Automation ───────────────────────────────
# Optional proxy for browser automation
# BATCHER_PROXY_URL=http://user:pass@host:port

# Login browser backend: camoufox (default); change to playwright to use Chromium.
LOGIN_BROWSER_BACKEND=camoufox

# Registration automation. Enabled by default; set to 0 to disable.
ENABLE_EXTERNAL_AUTOMATION=1
POSTMAN_HEADLESS=0
