{
  "name": "postman2api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "migrate": "bun src/db/migrate.ts",
    "build": "cd dashboard && bun run build",
    "release:package": "powershell -ExecutionPolicy Bypass -File scripts/ops/create-release-package.ps1",
    "win:deploy": "powershell -ExecutionPolicy Bypass -File scripts/ops/windows-deploy.ps1",
    "win:start": "powershell -ExecutionPolicy Bypass -File scripts/ops/windows-service-start.ps1",
    "win:stop": "powershell -ExecutionPolicy Bypass -File scripts/ops/windows-service-stop.ps1",
    "typecheck": "bunx tsc --noEmit && bunx tsc --noEmit -p dashboard/tsconfig.json",
    "test": "bun test",
    "postinstall": "bun scripts/ops/install-camoufox.ts",
    "test:stream": "bun test tests/stream-cancel.test.ts",
    "browser:camoufox:fetch": "bun scripts/ops/install-camoufox.ts",
    "browser:camoufox:smoke": "bun scripts/smoke/camoufox-smoke.ts",
    "browser:camoufox:smoke:node": "node --import tsx scripts/smoke/camoufox-smoke.ts",
    "browser:camoufox:smoke:postman": "node --experimental-strip-types scripts/smoke/camoufox-smoke.ts --postman-login",
    "audit:layout": "python scripts/ops/audit-project-layout.py .",
    "validate:api": "bun scripts/ops/validate-api-artifacts.ts",
    "smoke:upstream": "bun scripts/smoke/postman-upstream-compat-smoke.ts",
    "smoke:context": "bun scripts/smoke/context-priming-e2e.ts",
    "ci:check": "bun run audit:layout && bun run validate:api && bun run typecheck && bun test tests/regressions.test.ts --timeout 30000"
  },
  "dependencies": {
    "camoufox-js": "0.12.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.17",
    "playwright": "1.60.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "tsx": "4.22.4",
    "typescript": "^5.8.0"
  }
}
